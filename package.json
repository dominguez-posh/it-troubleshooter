{
  "name": "it-troubleshooter",
  "version": "0.1.0",
  "description": "Schritt-für-Schritt-Assistent für Supporter bei der Fernwartung (Pfeil-Overlay + LLM)",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "electron": "^45.2.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
